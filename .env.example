YT_SUB_HUB_LIBRARY_DIR=library
YT_SUB_HUB_LM_STUDIO_BASE_URL=http://localhost:1234/v1
YT_SUB_HUB_LM_STUDIO_API_KEY=lm-studio
YT_SUB_HUB_QWEN_MODEL=qwen/qwen3.6-35b-a3b
YT_SUB_HUB_GEMMA_MODEL=google/gemma-4-e4b
YT_SUB_HUB_NEO4J_URI=bolt://localhost:7687
YT_SUB_HUB_NEO4J_BROWSER_URL=http://localhost:7474/browser/
YT_SUB_HUB_NEO4J_USER=neo4j
YT_SUB_HUB_NEO4J_PASSWORD=change-me-in-.env
YT_SUB_HUB_KEEP_AUDIO=true
# Product quality mode. Allowed: strict, best_effort, draft
YT_SUB_HUB_QUALITY_MODE=strict
# Whisper fallback backend. Safe default is CPU because openai-whisper MPS can be slower on short/local runs.
# Allowed: openai-whisper-cpu, openai-whisper-mps, whisper-cpp-metal
YT_SUB_HUB_WHISPER_BACKEND=openai-whisper-cpu
YT_SUB_HUB_WHISPER_MODEL=base
YT_SUB_HUB_WHISPER_FP16=false
# whisper.cpp Metal backend. Install/build whisper.cpp and download the model yourself.
# `yt-sub-hub setup-whisper-cpp --download-model` stores a managed model under
# library/assets/whisper.cpp/models/ and prints these override values if needed.
YT_SUB_HUB_WHISPER_CPP_BIN=
YT_SUB_HUB_WHISPER_CPP_MODEL=
YT_SUB_HUB_WHISPER_CPP_THREADS=
YT_SUB_HUB_WHISPER_CPP_EXTRA_ARGS=
YT_SUB_HUB_ENABLE_GRAPH=true
YT_SUB_HUB_GRAPH_BEST_EFFORT=true
YT_SUB_HUB_ENABLE_DEEP_GRAPH_LLM=false
YT_SUB_HUB_DEEP_GRAPH_MIN_CONFIDENCE=0.55
YT_SUB_HUB_DEEP_GRAPH_MAX_CHUNK_CHARS=2500
YT_SUB_HUB_DEEP_GRAPH_MAX_OUTPUT_TOKENS=1500
YT_SUB_HUB_DEEP_GRAPH_BEST_EFFORT=true
YT_SUB_HUB_ENABLE_TRANSLATION=false
YT_SUB_HUB_TARGET_LANGUAGE=ru
YT_SUB_HUB_TRANSLATION_MODEL=google/gemma-4-e4b
YT_SUB_HUB_TRANSLATION_MAX_CHARS=2500
YT_SUB_HUB_TRANSLATION_CHUNK_MAX_SEGMENTS=30
YT_SUB_HUB_TRANSLATION_CHUNK_MAX_CHARS=2000
YT_SUB_HUB_TRANSLATION_CHUNK_TIMEOUT_SECONDS=120
# Conservative default until local LM Studio benchmark evidence supports increasing it.
YT_SUB_HUB_LM_STUDIO_TRANSLATION_CONCURRENCY=1
YT_SUB_HUB_YOUTUBE_DATA_API_CONCURRENCY=2
YT_SUB_HUB_LOCAL_CANDIDATE_SCORING_CONCURRENCY=2
YT_SUB_HUB_LLM_DISCOVERY_REVIEW_CONCURRENCY=1
YT_SUB_HUB_NEO4J_SYNC_CONCURRENCY=1
YT_SUB_HUB_QUEUE_MUTATION_CONCURRENCY=1
YT_SUB_HUB_LM_STUDIO_BENCHMARK_TIMEOUT_SECONDS=120
YT_SUB_HUB_LM_STUDIO_BENCHMARK_RUN_TIMEOUT_SECONDS=0
YT_SUB_HUB_LM_STUDIO_BENCHMARK_SAMPLE_CHUNKS=12
YT_SUB_HUB_TRANSLATION_BEST_EFFORT=false
YT_SUB_HUB_ANALYSIS_MAP_REDUCE_ENABLED=true
YT_SUB_HUB_ANALYSIS_CHUNK_MAX_SEGMENTS=120
YT_SUB_HUB_ANALYSIS_CHUNK_MAX_CHARS=4500
YT_SUB_HUB_ANALYSIS_CHUNK_TIMEOUT_SECONDS=120
YT_SUB_HUB_ANALYSIS_REDUCE_TIMEOUT_SECONDS=120
YT_SUB_HUB_ANALYSIS_DIRECT_MAX_SEGMENTS=180
YT_SUB_HUB_LM_STUDIO_TIMEOUT_SECONDS=120
YT_SUB_HUB_MAX_PROMPT_CHARS=3500
# Optional. Safer explicit cookie file for YouTube bot-check videos.
# Keep this file private and outside git. Does not read browser Keychain.
YT_SUB_HUB_YTDLP_COOKIES_FILE=
# Optional. Use explicit proxy for yt-dlp when direct YouTube access times out, e.g. http://127.0.0.1:12334
YT_SUB_HUB_YTDLP_PROXY=
# Optional. Browser cookies fallback. This may ask macOS Keychain for browser cookie access.
# Examples: chrome, safari, firefox. Leave empty by default.
YT_SUB_HUB_YTDLP_COOKIES_FROM_BROWSER=
# Optional. Examples: node, deno, bun, quickjs
YT_SUB_HUB_YTDLP_JS_RUNTIME=
YT_SUB_HUB_YTDLP_SOCKET_TIMEOUT=60
YT_SUB_HUB_YTDLP_RETRIES=10
# Optional. If token.json exists, metadata fetch uses YouTube Data API before yt-dlp.
# Set empty to disable this path and use yt-dlp metadata only.
# Captions through Data API require token.json authorized with https://www.googleapis.com/auth/youtube.force-ssl.
YT_SUB_HUB_YOUTUBE_API_TOKEN_FILE=token.json
# Official/Data API-first default. Set enabled only when you explicitly allow yt-dlp media download for Whisper fallback.
YT_SUB_HUB_MEDIA_DOWNLOAD=disabled
# Acceptance mode: data_api_only uses official captions only; full_processing allows media download + Whisper fallback.
# Leave empty/unset to derive from YT_SUB_HUB_MEDIA_DOWNLOAD.
YT_SUB_HUB_ACCEPTANCE_MODE=
YT_SUB_HUB_RUNTIME_STALE_AFTER_SECONDS=1800
YT_SUB_HUB_ENABLE_VISUAL_ANALYSIS=true
YT_SUB_HUB_VISION_MODEL=
YT_SUB_HUB_FRAME_IMAGE_FORMAT=jpg
YT_SUB_HUB_FRAME_CONTEXT_SECONDS=20
YT_SUB_HUB_VISUAL_MAX_OUTPUT_TOKENS=1200
YT_SUB_HUB_VISUAL_BEST_EFFORT=true
